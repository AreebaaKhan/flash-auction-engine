HOST=127.0.0.1
PORT=3000
DB_PATH=./data/auction.db
# Set a random secret of at least 32 characters to preserve tokens across restarts.
# When unset, the server generates an ephemeral secret on each startup.
JWT_SECRET=
MAX_CONNECTIONS=3000
MAX_CONNECTIONS_PER_IP=2500
USER_RATE_CAPACITY=15
USER_RATE_REFILL=5
IP_RATE_CAPACITY=1000
IP_RATE_REFILL=500
ANTI_SNIPE_WINDOW_MS=10000
ANTI_SNIPE_EXTENSION_MS=10000
ANTI_SNIPE_MAX=5
BACKUP_KEEP=10
BACKUP_INTERVAL_MS=30000
